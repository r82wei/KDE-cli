{
  "name": "kde-helper",
  "displayName": "KDE Helper",
  "description": "VS Code extension to manage KDE environments and projects.",
  "version": "0.0.1",
  "publisher": "kde-cli",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:kdeEnvView",
    "onCommand:kde.startEnv",
    "onCommand:kde.stopEnv",
    "onCommand:kde.useEnv",
    "onCommand:kde.k9s",
    "onCommand:kde.headlamp",
    "onCommand:kde.expose",
    "onCommand:kde.project.deploy",
    "onCommand:kde.project.undeploy",
    "onCommand:kde.project.redeploy",
    "onCommand:kde.project.exec-develop-env",
    "onCommand:kde.project.exec-deploy-env"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "kdeEnvView",
          "name": "KDE Environments"
        }
      ]
    },
    "commands": [
      {
        "command": "kde.startEnv",
        "title": "Start",
        "icon": "$(play)"
      },
      {
        "command": "kde.stopEnv",
        "title": "Stop",
        "icon": "$(stop)"
      },
      {
        "command": "kde.useEnv",
        "title": "Use",
        "icon": "$(check)"
      },
      {
        "command": "kde.k9s",
        "title": "K9s",
        "icon": "$(terminal)"
      },
      {
        "command": "kde.headlamp",
        "title": "Headlamp",
        "icon": "$(globe)"
      },
      {
        "command": "kde.expose",
        "title": "Port Forward",
        "icon": "$(radio-tower)"
      },
      {
        "command": "kde.project.deploy",
        "title": "Deploy",
        "icon": "$(debug-start)"
      },
      {
        "command": "kde.project.undeploy",
        "title": "Undeploy",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kde.project.redeploy",
        "title": "Redeploy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kde.project.exec-develop-env",
        "title": "Exec Develop Env",
        "icon": "$(terminal)"
      },
      {
        "command": "kde.project.exec-deploy-env",
        "title": "Exec Deploy Env",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "kde.startEnv",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.stopEnv",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.useEnv",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.k9s",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.expose",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.headlamp",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "kde.project.deploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline"
        },
        {
          "command": "kde.project.undeploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline"
        },
        {
          "command": "kde.project.redeploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline"
        },
        {
          "command": "kde.project.exec-develop-env",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline"
        },
        {
          "command": "kde.project.exec-deploy-env",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "test": "echo \"No tests\""
  }
}
