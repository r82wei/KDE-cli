{
  "name": "kde-helper",
  "displayName": "KDE Helper",
  "description": "VS Code extension to manage KDE environments and projects.",
  "version": "0.0.1",
  "publisher": "kde-cli",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:kdeEnvView",
    "onCommand:kde.addEnv",
    "onCommand:kde.refresh",
    "onCommand:kde.createEnv",
    "onCommand:kde.stopEnv",
    "onCommand:kde.k9s",
    "onCommand:kde.headlamp",
    "onCommand:kde.expose",
    "onCommand:kde.project.deploy",
    "onCommand:kde.project.undeploy",
    "onCommand:kde.project.redeploy",
    "onCommand:kde.project.logs",
    "onCommand:kde.project.exec-develop-env",
    "onCommand:kde.project.exec-deploy-env",
    "onCommand:kde.project.telepresenceReplace"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "kdeEnvView",
          "name": "KDE Environments"
        }
      ]
    },
    "commands": [
      {
        "command": "kde.addEnv",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "kde.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kde.createEnv",
        "title": "Create",
        "icon": "$(debug-start)"
      },
      {
        "command": "kde.stopEnv",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kde.k9s",
        "title": "K9s",
        "icon": "$(dashboard)"
      },
      {
        "command": "kde.headlamp",
        "title": "Headlamp",
        "icon": "$(globe)"
      },
      {
        "command": "kde.expose",
        "title": "Port Forward",
        "icon": "$(radio-tower)"
      },
      {
        "command": "kde.project.deploy",
        "title": "Deploy",
        "icon": "$(debug-start)"
      },
      {
        "command": "kde.project.undeploy",
        "title": "Undeploy",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kde.project.redeploy",
        "title": "Redeploy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kde.project.logs",
        "title": "Logs",
        "icon": "$(debug-line-by-line)"
      },
      {
        "command": "kde.project.exec-develop-env",
        "title": "Exec Develop Env",
        "icon": "$(terminal)"
      },
      {
        "command": "kde.project.exec-deploy-env",
        "title": "Exec Deploy Env",
        "icon": "$(terminal)"
      },
      {
        "command": "kde.project.telepresenceReplace",
        "title": "Telepresence Replace",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kde.addEnv",
          "when": "view == kdeEnvView",
          "group": "navigation@1"
        },
        {
          "command": "kde.refresh",
          "when": "view == kdeEnvView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "kde.createEnv",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline@1"
        },
        {
          "command": "kde.stopEnv",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline@2"
        },
        {
          "command": "kde.k9s",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline@3"
        },
        {
          "command": "kde.expose",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline@4"
        },
        {
          "command": "kde.headlamp",
          "when": "view == kdeEnvView && viewItem == environment",
          "group": "inline@5"
        },
        {
          "command": "kde.project.deploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "kde.project.undeploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "kde.project.redeploy",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@3"
        },
        {
          "command": "kde.project.logs",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@4"
        },
        {
          "command": "kde.project.exec-develop-env",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@5"
        },
        {
          "command": "kde.project.exec-deploy-env",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@6"
        },
        {
          "command": "kde.project.telepresenceReplace",
          "when": "view == kdeEnvView && viewItem == project",
          "group": "inline@7"
        }
      ]
    }
  },
  "scripts": {
    "test": "echo \"No tests\""
  }
}
